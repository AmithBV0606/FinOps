# Copy to config/settings.env (git-ignored) or export as environment variables.
FINOPS_DATABASE_URL=sqlite:///finops.db
# AWS named profiles (~/.aws/config). Never use root/admin keys.
FINOPS_AWS_PROFILE_READONLY=finops-ro
FINOPS_AWS_PROFILE_REMEDIATOR=finops-rw
FINOPS_REGIONS=["ap-south-1"]
FINOPS_LOOKBACK_DAYS=30
FINOPS_USD_TO_INR=88.0
# Safe-auto tier actions execute without manual approval only when true.
FINOPS_AUTO_APPLY=false
# Cost Explorer costs $0.01/request; at most one call per day is made and cached.
FINOPS_COST_EXPLORER_ENABLED=true
FINOPS_COMPUTE_OPTIMIZER_ENABLED=true
FINOPS_SCHEDULE_CRON_HOUR=2
FINOPS_API_URL=http://127.0.0.1:8000
